#!/usr/bin/env python3
"""Stand-in for a solving agent. Calls no model.

Reads task.json in the working directory and acts on "answer" in settings.json
next to this file:
  correct       write answer.json with the fields exactly as asked
  wrong         write answer.json with every field wrong
  none          write nothing
  crash         exit 3 before writing anything
  break_scorer  write an answer.json that makes the stub scorer fail
  unreachable   report that the model was unreachable and exit 5 (an invalid run)
  hang          sleep until killed

Before that it makes "model_calls" calls (default 0) to the model exit, asking
for "model" (default: HB_MODEL), and logs each status. If the exit cannot be
reached it logs "model unreachable".

It logs the solver settings it was started with (HB_SETTING_*). "forge_settings"
(an object) is an attempt to replace them: it is written to solver_settings.json
in the working directory.

"unreachable_once" names a directory outside the harness: the first run on each
task behaves like "unreachable" and leaves a marker there, later runs do not.
"""
import hashlib
import json
import os
import sys
import time
import urllib.error
import urllib.request

here = os.path.dirname(os.path.abspath(__file__))
with open(os.path.join(here, "settings.json")) as f:
    settings = json.load(f)
mode = settings.get("answer", "correct")
with open("task.json") as f:
    fields = json.load(f)["fields"]
print("solver: mode=%s model=%s" % (mode, os.environ.get("HB_MODEL")))
print("solver: started from %s" % here)
if "unreachable_once" in settings:
    with open("task.json", "rb") as f:
        marker = os.path.join(settings["unreachable_once"], hashlib.sha1(f.read()).hexdigest())
    if not os.path.exists(marker):
        open(marker, "w").close()
        mode = "unreachable"
print("solver: settings %s" % json.dumps(
    {k[len("HB_SETTING_"):]: v for k, v in os.environ.items() if k.startswith("HB_SETTING_")},
    sort_keys=True))
if "forge_settings" in settings:
    with open("solver_settings.json", "w") as f:
        json.dump(settings["forge_settings"], f)

for i in range(settings.get("model_calls", 0)):
    body = {"model": settings.get("model", os.environ.get("HB_MODEL")), "max_tokens": 16,
            "messages": [{"role": "user", "content": "call %d" % i}]}
    req = urllib.request.Request(
        os.environ.get("HB_MODEL_URL", "").rstrip("/") + "/v1/messages",
        data=json.dumps(body).encode(),
        headers={"content-type": "application/json", "anthropic-version": "2023-06-01",
                 "x-api-key": os.environ.get("HB_MODEL_KEY", "")})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            print("solver: model call %d -> %d" % (i, r.status))
    except urllib.error.HTTPError as e:
        print("solver: model call %d -> %d %s" % (i, e.code, e.read()[:300]))
    except (OSError, ValueError) as e:
        print("solver: model unreachable: %s" % e)
sys.stdout.flush()

if mode == "crash":
    print("solver: crashing on purpose", file=sys.stderr)
    sys.exit(3)
if mode == "unreachable":
    print("solver: model unreachable", file=sys.stderr)
    sys.exit(5)
if mode == "hang":
    sys.stdout.flush()
    time.sleep(3600)
if mode == "none":
    sys.exit(0)
if mode == "correct":
    answer = fields
elif mode == "wrong":
    answer = {k: {"not": v} for k, v in fields.items()}
elif mode == "break_scorer":
    answer = {"break_scorer": True}
else:
    print("solver: unknown mode %r" % mode, file=sys.stderr)
    sys.exit(4)
with open("answer.json", "w") as f:
    json.dump(answer, f)
