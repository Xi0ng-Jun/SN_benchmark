{
  "tasks": [
    {"id": "p1", "files": "tasks/p1"},
    {"id": "p2", "group": "g1", "files": "tasks/p2"},
    {"id": "p3", "group": "g1", "files": "tasks/p3"},
    {"id": "e1", "files": "tasks/e1"},
    {"id": "e2", "group": "g2", "files": "tasks/e2"},
    {"id": "e3", "group": "g2", "files": "tasks/e3"}
  ],
  "split": {"practice": ["p1", "p2", "p3"], "exam": ["e1", "e2", "e3"]},
  "commands": {
    "run": ["python3", "run.py"],
    "score": ["python3", "score.py"],
    "enter": ["python3", "enter.py"],
    "invalid": ["python3", "invalid.py"]
  },
  "score": {"file": "score.json", "key": "score"},
  "initial_harness": "harness",
  "limits": {
    "run_seconds": 60, "score_seconds": 60, "enter_seconds": 60,
    "run_budget": {"requests": 5},
    "dev_budget": null,
    "dev_seconds": 600,
    "parallel_runs": 2
  },
  "models": {
    "solver": "stub-solver",
    "developer": "stub-developer",
    "upstream_url": "${STUB_UPSTREAM_URL:-http://127.0.0.1:9}",
    "upstream_key_env": "STUB_UPSTREAM_KEY"
  },
  "solver_settings": {"thinking": "high", "max_output_tokens": "4096"},
  "developer": {
    "command": ["sh", "-c", "exec \"$HB_PYTHON\" \"$HB_WORKSPACE/stub_developer.py\""],
    "memory": "2g",
    "cpus": 2
  },
  "exam": {
    "compare": {"general": "harness"},
    "repeats": 2,
    "aggregate": "mean",
    "failure_score": 0,
    "invalid_reruns": 1,
    "uses": 1
  }
}
