#!/usr/bin/env python3
"""mcr_check: certify a layout without promoting it, or print the terminal gate report.

Usage: mcr_check [--gds work/draft/layout.gds] [--src DIR]   certificate + ratchet preview
       mcr_check --gate [--elapsed SEC]                     gate report for the current best
Prints one JSON object.
"""
from __future__ import annotations

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import mcr_common as mc  # noqa: E402
from ssap.kernel.promote import draft_needs_evaluation, load_best, load_best_dict  # noqa: E402
from ssap.kernel.ratchet import decide  # noqa: E402
from ssap.kernel.watermarks import compute_gate  # noqa: E402


def gate_report(elapsed: float | None = None) -> tuple[dict, dict]:
    ws, suite, wm = mc.workspace(), mc.suite(), mc.watermarks()
    if elapsed is None:
        elapsed = mc.elapsed_sec() or 0.0
    fork = wm.fork_meta(elapsed)
    best = load_best(ws)
    m_best = list(best.m(suite.tier_spec)) if best else None
    gate = compute_gate(fork, m_best, unevaluated_draft=draft_needs_evaluation(ws),
                        advisory_triggers=suite.gate_advisories(best))
    gate["best_cert"] = mc.cert_view(load_best_dict(ws))
    gate["mirror_names"] = list(suite.tier_spec.names)
    return gate, fork


def main(argv=None) -> int:
    ws = mc.workspace()
    ap = argparse.ArgumentParser(prog="mcr_check")
    ap.add_argument("--gds", default=str(ws.draft_artifact))
    ap.add_argument("--src", default=None)
    ap.add_argument("--gate", action="store_true")
    ap.add_argument("--elapsed", type=float, default=None)
    args = ap.parse_args(argv)
    if args.gate:
        gate, _ = gate_report(args.elapsed)
        print(json.dumps(gate, indent=1, default=str))
        return 0
    suite = mc.suite()
    src = args.src if args.src is not None else (str(ws.draft_aux) if ws.draft_aux.is_dir() else None)
    from pathlib import Path
    cert = suite.evaluate(Path(os.path.abspath(args.gds)), Path(src) if src else None)
    best = load_best(ws)
    dec = decide(cert, best, suite.tier_spec)
    out = {"tool": "mcr_check", "candidate": os.path.abspath(args.gds),
           "cert": mc.cert_view(cert.as_dict(suite.tier_spec)),
           "would_promote": dec.promote, "reason": dec.reason,
           "best_cert": mc.cert_view(load_best_dict(ws)), "mirror_names": list(suite.tier_spec.names)}
    print(json.dumps(out, indent=1, default=str))
    return 0


if __name__ == "__main__":
    sys.exit(main())
