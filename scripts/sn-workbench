#!/usr/bin/env bash
# The person's side of action requests: list, confirm or reject them on a running workbench.
# Runs from the evaluation repository root so config and run paths resolve.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
PYTHONPATH="$ROOT/src" exec "${SN_WORKBENCH_PYTHON:-$ROOT/.venv/bin/python}" -m rag_eval.workbench.operator_client "$@"
