  "abstract_tasks": {
   "where": "abstract",
   "values": {
    "tasks": 40
   },
   "quote": "We introduce AnalogLayoutWorld, an open-source agent benchmark with 40 expert-reviewed tasks for end-to-end layout generation from fixed transistor-level netlists."
  },
  "abstract_submission_acceptance": {
   "where": "abstract",
   "values": {
    "configurations": 13,
    "gds_produced_pct": 91.1,
    "accepted_pct": 21.3
   },
   "quote": "Across 13 model-harness configurations, 91.1% of attempts produce GDS layouts, but only 21.3% satisfy the benchmark’s acceptance criteria."
  },
  "trials_per_task": {
   "where": "section 4.1",
   "values": {
    "trials": 3
   },
   "quote": "Using the environment, three-hour agent budget, and independent evaluation protocol described in Section 3, we run three independent trials per task."
  },
  "agent_budget_hours": {
   "where": "section 3.2",
   "values": {
    "hours": 3
   },
   "quote": "Each attempt has a three-hour wall-clock budget for layout generation, debugging, and self-checks."
  },
  "repeated_verification": {
   "where": "section 5.1",
   "values": {
    "drc_first_pass_after_first_call_pct": 90.3,
    "lvs_first_pass_after_first_call_pct": 66.8
   },
   "quote": "Among trajectories with a recovered passing self-check, 90.3% of DRC first passes and 66.8% of LVS first passes occur after the first verification call."
  },
  "difficulty_vs_size": {
   "where": "section 5.2",
   "values": {
    "spearman_score_vs_devices": -0.73
   },
   "quote": "Averaging final scores across the six plotted configurations yields a negative task-level correlation with device count ( $\\rho_{s}=-0.73$ ), indicating that larger circuits tend to be more difficult for the evaluated systems."
  },
  "time_limit_hits": {
   "where": "section 5.3",
   "values": {
    "glm53_flash_hits": 51,
    "attempts": 120
   },
   "quote": "GLM-5.3 Flash reaches the agent time limit in 51 of 120 attempts, compared with none for GPT-6 Astra."
  },
