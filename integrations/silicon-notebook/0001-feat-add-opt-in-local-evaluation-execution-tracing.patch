+def test_llm_captures_provider_messages_and_logical_result_without_client_secrets(monkeypatch):
+    response = _Resp('{"answer":"visible answer"}')
+    response.choices[0].message.reasoning_content = "hidden reasoning must stay hidden"
+    create = _FakeCreate([response])
+    client = _make(monkeypatch, create, model="public-model")
+    messages = [{"role": "user", "content": "business question"}]
+    with capture_evaluation_trace() as capture:
+        result = client.chat_json(messages, "answer schema")
+    trace = capture.to_dict()
+    span, = trace["spans"]
+    assert span["input"] == {"messages": provider_messages(messages, "answer schema"), "model": "public-model"}
+    assert span["output"] == result == '{"answer":"visible answer"}'
+    assert span["metadata"]["call_boundary"] == "logical"
+    assert trace["capture_errors"] == []
+    encoded = json.dumps(trace)
+    assert "https://x" not in encoded
+    assert "api_key" not in encoded
+    assert "hidden reasoning" not in encoded
+    assert len(create.calls) == 1
