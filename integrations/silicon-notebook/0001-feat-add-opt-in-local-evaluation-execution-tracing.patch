@@ -0,0 +1,189 @@
+"""Private evaluation traces preserve request behavior and context boundaries."""
+import asyncio
+from concurrent.futures import ThreadPoolExecutor
+from contextvars import copy_context
+import json
+from pathlib import Path
+import subprocess
+import sys
+import threading
+
+import pytest
+
+from app.core.evaluation_tracing import (
+    CAPTURE_SCHEMA_VERSION,
+    capture_evaluation_trace,
+    evaluation_span,
+    traced_evaluation,
+)
+
+
+def test_nested_snapshots_parentage_and_disabled_selector():
+    calls = []
+
+    @traced_evaluation("child", "tool", input_selector=lambda args: calls.append(1) or args["value"])
+    def operation(value):
+        return value
+
+    value = {"text": ["original"]}
+    assert operation(value) is value
+    assert calls == []
+    with capture_evaluation_trace() as capture:
+        with evaluation_span("root", "agent", input="question") as root:
+            assert operation(value) is value
+            root.set_output("answer")
+        value["text"].append("later")
+    trace = capture.to_dict()
+    assert trace["schema_version"] == CAPTURE_SCHEMA_VERSION
+    assert trace["closed"] is True
+    assert trace["capture_errors"] == []
+    parent, child = trace["spans"]
+    assert child["parent_id"] == parent["span_id"]
+    assert parent["parent_id"] is None
+    assert child["input"] == child["output"] == {"text": ["original"]}
+    assert parent["output"] == "answer"
+    assert child["start_time"] <= child["end_time"] <= parent["end_time"]
+    assert all(s["status"] == "completed" for s in trace["spans"])
+    trace["spans"].clear()
+    assert len(capture.to_dict()["spans"]) == 2
+
+
+@pytest.mark.parametrize("error", [ValueError("private exception"), asyncio.CancelledError("secret")])
+def test_business_errors_are_reraised_unchanged_and_never_leak_text(error):
+    with capture_evaluation_trace() as capture:
+        with pytest.raises(type(error)) as raised:
+            with evaluation_span("failing", "tool"):
+                raise error
+    assert raised.value is error
+    trace = capture.to_dict()
+    assert trace["spans"][0]["status"] == ("cancelled" if isinstance(error, asyncio.CancelledError) else "error")
+    assert trace["spans"][0]["error_type"] == type(error).__name__
+    assert "private exception" not in json.dumps(trace)
+    assert "secret" not in json.dumps(trace)
+
+
+def test_projection_failures_do_not_erase_result_or_repeat_business_work():
+    calls = []
+
+    def bad_selector(*args):
+        raise ValueError("secret selector text")
+
+    @traced_evaluation("work", "tool", input_selector=bad_selector, output_selector=bad_selector)
+    def operation():
+        calls.append(1)
+        return "result"
+
+    with capture_evaluation_trace() as capture:
+        assert operation() == "result"
+        with evaluation_span("unsafe", "tool", input=object()) as span:
+            span.set_metadata(unsafe=object())
+    trace = capture.to_dict()
+    assert calls == [1]
+    assert len(trace["capture_errors"]) == 4
+    assert "secret selector text" not in json.dumps(trace)
+
+
+def test_concurrent_requests_and_copy_context_threads_keep_parents():
+    barrier = threading.Barrier(2)
+
+    def request(question):
+        with capture_evaluation_trace() as capture:
+            with evaluation_span("request", "agent", input=question):
+                barrier.wait(timeout=5)
+                with ThreadPoolExecutor(max_workers=1) as pool:
+                    def work():
+                        with evaluation_span("tool", "tool", input=question):
+                            pass
+                    pool.submit(copy_context().run, work).result(timeout=5)
+        return capture.to_dict()
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        a, b = list(pool.map(request, ["a", "b"]))
+    assert a["trace_id"] != b["trace_id"]
+    for trace in (a, b):
+        root, child = trace["spans"]
+        assert child["parent_id"] == root["span_id"]
+        assert root["input"] == child["input"]
+
+
+def test_nested_capture_restores_outer_and_closed_copy_cannot_write():
+    with capture_evaluation_trace() as outer:
+        with evaluation_span("outer", "agent"):
+            late = copy_context()
+            with capture_evaluation_trace() as inner:
+                with evaluation_span("inner", "agent"):
+                    pass
+            with evaluation_span("outer-child", "tool"):
+                pass
+    original = outer.to_dict()
+    with capture_evaluation_trace() as next_capture:
+        def late_work():
+            with evaluation_span("late", "tool"):
+                pass
+        late.run(late_work)
+    assert outer.to_dict() == original
+    assert next_capture.to_dict()["spans"] == []
+    assert inner.to_dict()["spans"][0]["parent_id"] is None
+    assert original["spans"][1]["parent_id"] == original["spans"][0]["span_id"]
+
+
+def test_unfinished_child_is_disclosed_at_capture_close():
+    with capture_evaluation_trace() as capture:
+        manager = evaluation_span("unfinished", "tool")
+        manager.__enter__()
+    before = capture.to_dict()
+    manager.__exit__(None, None, None)
+    assert capture.to_dict() == before
+    assert before["capture_errors"][0]["code"] == "span_open_at_close"
+
+
+def test_async_tasks_are_isolated_even_when_their_scopes_interleave():
+    async def run():
+        entered = asyncio.Event()
+        release = asyncio.Event()
+
+        async def request(name):
+            with capture_evaluation_trace() as capture:
+                with evaluation_span(name, "agent"):
+                    if name == "first":
+                        entered.set()
+                        await release.wait()
+                    else:
+                        await entered.wait()
+                        release.set()
+                    with evaluation_span(name + "-child", "tool"):
+                        pass
+            return capture.to_dict()
+
+        return await asyncio.gather(request("first"), request("second"))
+
+    first, second = asyncio.run(run())
+    assert [span["name"] for span in first["spans"]] == ["first", "first-child"]
+    assert [span["name"] for span in second["spans"]] == ["second", "second-child"]
+
+
+def test_closed_span_handle_cannot_change_its_completed_snapshot():
+    with capture_evaluation_trace() as capture:
+        with evaluation_span("complete", "tool") as span:
+            span.set_output("original")
+        span.set_output("late")
+    assert capture.to_dict()["spans"][0]["output"] == "original"
+
+
+def test_standalone_recorder_needs_no_optional_dependencies_and_performs_no_io():
+    backend = Path(__file__).resolve().parents[1]
+    script = """
+import builtins, socket, sys
+sys.path.insert(0, sys.argv[1])
+from app.core.evaluation_tracing import capture_evaluation_trace, evaluation_span
+def forbidden(*args, **kwargs):
+    raise AssertionError('capture attempted I/O')
+builtins.open = forbidden
+socket.socket = forbidden
+with capture_evaluation_trace() as capture:
+    with evaluation_span('root', 'agent', input='question') as span:
+        span.set_output('answer')
+assert capture.to_dict()['capture_errors'] == []
+assert not any(name.startswith(('deepeval', 'pydantic', 'openai')) for name in sys.modules)
+"""
+    subprocess.run([sys.executable, "-I", "-c", script, str(backend)], check=True, capture_output=True, text=True)
