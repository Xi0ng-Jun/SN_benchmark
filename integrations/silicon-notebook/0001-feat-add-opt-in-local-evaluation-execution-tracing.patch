index 0000000000000000000000000000000000000000..d060ecab55d143def5343030eb7fb3249c051e2a
--- /dev/null
+++ b/backend/app/core/evaluation_tracing.py
@@ -0,0 +1,212 @@
+"""Opt-in, in-memory business traces for private evaluation artifacts.
+
+This module uses only the standard library and performs no I/O. Callers own
+export/storage and must explicitly select JSON business values: never pass a
+client, repository, settings object, credentials, or hidden model reasoning.
+Times are monotonic seconds; nested durations must not be summed as wall time.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from functools import wraps
+from inspect import signature
+import math
+from threading import RLock
+from time import perf_counter
+from uuid import uuid4
+
+
+CAPTURE_SCHEMA_VERSION = "sn-execution-trace-v1"
+_capture: ContextVar[EvaluationCapture | None] = ContextVar("evaluation_capture", default=None)
+_span: ContextVar[EvaluationSpan | None] = ContextVar("evaluation_span", default=None)
+
+
+def _snapshot(value):
+    """Copy only plain JSON values; never introspect/serialize arbitrary objects."""
+    if value is None or type(value) in (str, bool, int):
+        return value
+    if type(value) is float and math.isfinite(value):
+        return value
+    if type(value) in (list, tuple):
+        return [_snapshot(item) for item in value]
+    if type(value) is dict and all(type(key) is str for key in value):
+        return {key: _snapshot(item) for key, item in value.items()}
+    raise TypeError("evaluation values must be explicitly projected JSON")
+
+
+class EvaluationCapture:
+    def __init__(self):
+        self.trace_id = uuid4().hex
+        self._lock = RLock()
+        self._spans = []
+        self._errors = []
+        self._start = perf_counter()
+        self._end = None
+        self.closed = False
+
+    def _error(self, code, span_id=None):
+        with self._lock:
+            if not self.closed:
+                self._errors.append({"code": code, "span_id": span_id})
+
+    def _close(self):
+        with self._lock:
+            self._end = perf_counter()
+            for entry in self._spans:
+                if entry["end_time"] is None:
+                    self._error("span_open_at_close", entry["span_id"])
+            self.closed = True
+
+    def to_dict(self):
+        """Return a detached snapshot, including lifecycle/capture completeness."""
+        with self._lock:
+            return _snapshot({
+                "schema_version": CAPTURE_SCHEMA_VERSION,
+                "trace_id": self.trace_id,
+                "closed": self.closed,
+                "spans": self._spans,
+                "capture_errors": self._errors,
+                "duration_ms": ((self._end or perf_counter()) - self._start) * 1000,
+            })
+
+
+class EvaluationSpan:
+    def __init__(self, capture=None, entry=None):
+        self._capture = capture
+        self._entry = entry
+
+    def _set(self, key, value):
+        capture = self._capture
+        if capture is None or capture.closed:
+            return
+        try:
+            value = _snapshot(value)
+            with capture._lock:
+                if not capture.closed and self._entry["end_time"] is None:
+                    if key == "metadata":
+                        self._entry[key].update(value)
+                    else:
+                        self._entry[key] = value
+        except Exception:
+            capture._error("invalid_" + key, self._entry["span_id"])
+
+    def set_output(self, value):
+        self._set("output", value)
+
+    def set_metadata(self, **fields):
+        self._set("metadata", fields)
+
+    def _projection_error(self, field):
+        if self._capture is not None:
+            self._capture._error("projection_" + field, self._entry["span_id"])
+
+
+_NOOP_SPAN = EvaluationSpan()
+
+
+@contextmanager
+def capture_evaluation_trace():
+    """Capture the current context; copy_context propagates it to joined workers."""
+    capture = EvaluationCapture()
+    capture_token = _capture.set(capture)
+    span_token = _span.set(None)
+    try:
+        yield capture
+    finally:
+        capture._close()
+        _span.reset(span_token)
+        _capture.reset(capture_token)
+
+
+@contextmanager
+def evaluation_span(name: str, kind: str, *, input: object = None, metadata: dict | None = None):
+    capture = _capture.get()
+    if capture is None or capture.closed:
+        yield _NOOP_SPAN
+        return
+    with capture._lock:
+        if capture.closed:
+            handle = _NOOP_SPAN
+        else:
+            parent = _span.get()
+            entry = {
+                "span_id": uuid4().hex,
+                "parent_id": parent._entry["span_id"] if parent and parent._capture is capture else None,
+                "name": name,
+                "kind": kind,
+                "input": None,
+                "output": None,
+                "metadata": {},
+                "status": "running",
+                "start_time": perf_counter(),
+                "end_time": None,
+                "duration_ms": None,
+            }
+            capture._spans.append(entry)
+            handle = EvaluationSpan(capture, entry)
+    handle._set("input", input)
+    handle._set("metadata", metadata or {})
+    token = _span.set(handle)
+    status, error_type = "completed", None
+    try:
+        yield handle
+    except BaseException as error:
+        error_type = type(error).__name__
+        status = "cancelled" if error_type in {"AskCancelled", "CancelledError"} else "error"
+        raise
+    finally:
+        _span.reset(token)
+        with capture._lock:
+            if not capture.closed and handle._entry is not None:
+                end = perf_counter()
+                handle._entry.update(status=status, end_time=end,
+                                     duration_ms=(end - handle._entry["start_time"]) * 1000)
+                if error_type:
+                    handle._entry["error_type"] = error_type
+
+
+def set_evaluation_metadata(**fields):
+    """Attach explicitly selected business values to the active native span."""
+    handle = _span.get()
+    if handle is not None:
+        handle.set_metadata(**fields)
+
+
+def traced_evaluation(name, kind, *, stage=None, input_selector=None,
+                      output_selector=None, output_arguments_selector=None, metadata=None):
+    """Trace synchronous seams without changing their signatures or outcomes.
+
+    Selectors run only during capture, on bound arguments / the original result.
+    Capture failures never execute the business operation a second time.
+    """
+    def decorate(function):
+        parameters = signature(function)
+
+        @wraps(function)
+        def wrapped(*args, **kwargs):
+            capture = _capture.get()
+            if capture is None or capture.closed:
+                return function(*args, **kwargs)
+            with evaluation_span(name, kind, metadata={**(metadata or {}), **({"stage": stage} if stage else {})}) as handle:
+                bound = None
+                if input_selector is not None or output_arguments_selector is not None:
+                    try:
+                        bound = parameters.bind(*args, **kwargs)
+                        bound.apply_defaults()
+                        if input_selector is not None:
+                            handle._set("input", input_selector(bound.arguments))
+                    except Exception:
+                        handle._projection_error("input")
+                result = function(*args, **kwargs)
+                try:
+                    if output_arguments_selector is not None:
+                        handle.set_output(output_arguments_selector(bound.arguments))
+                    else:
+                        handle.set_output(output_selector(result) if output_selector else result)
+                except Exception:
+                    handle._projection_error("output")
+                return result
+
+        return wrapped
+    return decorate
