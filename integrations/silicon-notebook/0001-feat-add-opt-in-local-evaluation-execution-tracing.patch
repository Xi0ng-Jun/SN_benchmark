new file mode 100644
index 0000000000000000000000000000000000000000..6bbcd7a62c67829b1eeec6b0b43c525618dca0ac
--- /dev/null
+++ b/backend/app/services/evaluation_trace_projection.py
@@ -0,0 +1,105 @@
+"""Explicit native business projections for private evaluation capture.
+
+Keep allowlists here; adding model/service attributes must never implicitly add
+them to evaluation artifacts. No generic model/dataclass/object serialization.
+"""
+
+
+def fields(value, names):
+    return {name: getattr(value, name) for name in names}
+
+
+def arguments(*names):
+    return lambda bound: {name: bound[name] for name in names}
+
+
+def ask_input(bound):
+    return fields(bound["payload"], ("question", "mode", "retrieval_effort"))
+
+
+def ask_output(value):
+    return fields(value, ("answer", "conclusion", "grounded", "mode", "retrieval_query"))
+
+
+def intent_output(value):
+    # This is a specific validated public model, not an arbitrary runtime object.
+    return value.model_dump(mode="json", include={
+        "objective", "resolved_question", "intent_type", "result_scope",
+        "completeness_required", "entities", "mandatory_topics", "comparison_axes",
+        "constraints", "excluded_topics", "expected_output", "assumptions",
+        "ambiguities", "confidence", "needs_clarification", "confirmed",
+    })
+
+
+def chunks_output(values):
+    return [fields(item, ("chunk_id", "source_id", "source_title", "section_path",
+                          "text", "score", "relevance")) for item in values]
+
+
+def knowledge_output(values):
+    # The full evidence text sent to synthesis is captured at the synthesis seam.
+    # Knowledge payload schemas are extension-defined and are not serialized here.
+    return [fields(item, ("object_id", "object_type", "score", "relevance")) for item in values]
+
+
+def elements_output(values):
+    return [fields(item, ("element_id", "source_id", "source_title", "location_label",
+                          "element_type", "text", "score")) for item in values]
+
+
+def synthesis_output(result):
+    return {"answer": result[0], "grounded": result[1]}
+
+
+def plan_output(values):
+    return [fields(item, ("query", "types", "prefer", "reason")) for item in values]
+
+
+def decision_output(value):
+    result = fields(value, (
+        "sufficient", "next_action", "reason", "expand_object_id", "expand_edge_type",
+        "expand_direction", "community_focal", "elements_query", "ppr_query",
+        "chunks_query", "exact_term", "chain_start_object_id", "chain_target_object_id",
+        "chain_edge_type", "chain_direction", "enumerate_kind", "enumerate_object_type",
+        "enumerate_source_id", "enumerate_source_title", "enumerate_collection",
+        "enumerate_scope", "read_document_source", "read_document_coverage",
+        "plugin_action_arguments",
+    ))
+    result["new_sub_query"] = plan_output([value.new_sub_query])[0] if value.new_sub_query else None
+    result["outline_sections"] = [fields(item, ("id", "title", "evidence_keys"))
+                                  for item in value.outline_sections]
+    return result
+
+
+def action_input(bound):
+    return decision_output(bound["decision"])
+
+
+def action_output(bound):
+    # Native state-mutating actions publish their admitted/skip result via record.
+    # Only selected outcome fields; never serialize arbitrary trace detail/errors.
+    step = bound["state"].trace[-1]
+    return {"step_type": step.step_type, "result": {
+        key: step.detail[key] for key in (
+            "result_ids", "result_ids_truncated", "new", "hits", "count",
+            "complete", "truncated", "source_title", "coverage",
+        ) if key in step.detail and type(step.detail[key]) in (str, int, bool, list)
+    }}
+
+
+def initial_plan_output(bound):
+    state = bound["state"]
+    return {"subqueries": plan_output(state.subqueries),
+            "pending_queries": state.pending_intent_queries,
+            "origin": "confirmed_intent" if state.intent_queries else "planner"}
+
+
+def reasoning_output(value):
+    return {
+        "top_hits": knowledge_output(value.top_hits),
+        "chunks": chunks_output(value.chunks),
+        "elements": elements_output(value.elements),
+        "attempted": [{key: row[key] for key in ("query", "new", "tries") if key in row}
+                      for row in value.attempted],
+        "outline": [fields(item, ("id", "title", "evidence_keys")) for item in value.outline],
+    }
