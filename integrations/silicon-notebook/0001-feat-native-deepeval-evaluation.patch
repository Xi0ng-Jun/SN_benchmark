+"""Public DeepEval SDK double for hermetic base-dependency tests."""
+from contextvars import ContextVar
+from functools import wraps
+from inspect import signature
+import sys
+from types import ModuleType, SimpleNamespace
+from uuid import uuid4
+
+import pytest
+
+
+@pytest.fixture
+def native_sdk(monkeypatch):
+    sdk = ModuleType("deepeval.tracing")
+    sdk.current_span_context = ContextVar("fake_sdk_span", default=None)
+    sdk.spans = []
+    sdk.fail_enter = False
+    sdk.fail_exit = False
+
+    def update_current_span(**fields):
+        span = sdk.current_span_context.get()
+        if span is not None:
+            for key, value in fields.items():
+                # SDK 4.2.2 uses truthiness for input/output/metadata updates.
+                if value:
+                    setattr(span, key, value)
+
+    def observe(*, name, type):
+        def decorate(function):
+            @wraps(function)
+            def wrapped(*args, **kwargs):
+                if sdk.fail_enter:
+                    raise RuntimeError("SDK entry failed")
+                parent = sdk.current_span_context.get()
+                span = SimpleNamespace(uuid=uuid4().hex, name=name, type=type,
+                    parent_uuid=parent.uuid if parent else None, input=None,
+                    output=None, metadata={}, end_time=None, status="success", error=None,
+                    function_arguments=signature(function).bind(*args, **kwargs).arguments,
+                    automatic_result=None)
+                sdk.spans.append(span)
+                token = sdk.current_span_context.set(span)
+                try:
+                    span.automatic_result = function(*args, **kwargs)
+                    return span.automatic_result
+                except BaseException as error:
+                    span.status = "errored"
+                    span.error = str(error)
+                    raise
+                finally:
+                    span.end_time = 1
+                    sdk.current_span_context.reset(token)
+                    if sdk.fail_exit:
+                        raise RuntimeError("SDK exit failed")
+            return wrapped
+        return decorate
+
+    sdk.observe = observe
+    sdk.update_current_span = update_current_span
+    monkeypatch.setitem(sys.modules, "deepeval", ModuleType("deepeval"))
+    monkeypatch.setitem(sys.modules, "deepeval.tracing", sdk)
+    return sdk
